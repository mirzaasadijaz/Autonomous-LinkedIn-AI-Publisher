# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# Google Gemini API key (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key

# Tavily web search API key (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# LinkedIn OAuth access token (scopes: w_member_social, openid, profile)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Optional: only needed if you use the Groq package
GROQ_API_KEY=your_groq_api_key
